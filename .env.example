# Required MovieBox upstream credentials. Set these in Render Environment Variables.
MOVIEBOX_GATEWAY_SECRET=
MOVIEBOX_APP_ID=
MOVIEBOX_APP_KEY=
MOVIEBOX_GUEST_TOKEN=
MOVIEBOX_GUEST_USER_ID=

# Optional: stable device identifier used only for GSLB domain conversion.
MOVIEBOX_DEVICE_ID=

# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=https://wotchly.netlify.app
FRONTEND_URL=https://wotchly.netlify.app
